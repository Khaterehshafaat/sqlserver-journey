    (3, N'شرکت اصفهان 1',  N'اصفهان',  '(031) 333-1111'), -- unchanged
    (5, N'شرکت مشهد 1',    N'مشهد',    '(051) 555-0000'), -- changed
    (6, N'شرکت مشهد 2',    N'مشهد',    '(051) 555-1111'), -- new
    (7, N'شرکت اصفهان 1',  N'اصفهان',  '(031) 333-1111'); -- new
GO

SELECT * FROM dbo.S_Customers;
SELECT * FROM dbo.T_Customers;

/* =====================================================================
   MERGE <Target_TableName>
   USING <Source_TableName>
        ON Predicate
   WHEN MATCHED THEN                  -- row exists in BOTH T and S
        UPDATE | DELETE
   WHEN NOT MATCHED [BY TARGET] THEN  -- row exists in S but NOT in T
        INSERT
   WHEN NOT MATCHED BY SOURCE THEN    -- row exists in T but NOT in S
        DELETE;
   ===================================================================== */

-- 3) THE FULL MERGE: INSERT + UPDATE + DELETE IN ONE STATEMENT
MERGE INTO dbo.T_Customers AS T          -- TARGET: table being modified
USING       dbo.S_Customers AS S         -- SOURCE: table with new data
    ON  T.CustomerID = S.CustomerID
WHEN MATCHED THEN                        -- key exists in both -> UPDATE
    UPDATE SET
        T.CompanyName = S.CompanyName,
        T.City        = S.City,
        T.Phone       = S.Phone
WHEN NOT MATCHED THEN                    -- key only in SOURCE -> INSERT
    INSERT (CustomerID, CompanyName, City, Phone)
    VALUES (S.CustomerID, S.CompanyName, S.City, S.Phone)
WHEN NOT MATCHED BY SOURCE THEN          -- key only in TARGET -> DELETE
    DELETE
;   -- MERGE always requires a terminating semicolon

-- 4) VERIFY RESULT: TARGET now mirrors SOURCE exactly
SELECT * FROM dbo.S_Customers;
SELECT * FROM dbo.T_Customers;
