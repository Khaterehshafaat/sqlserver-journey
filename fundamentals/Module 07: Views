-- View: List of companies with their order count

CREATE VIEW COMPANY_LIST AS
SELECT
    C.CompanyName,
    C.City,
    (SELECT COUNT(O.OrderID) 
     FROM Orders AS O 
     WHERE O.CustomerID = C.CustomerID) AS NUM
FROM Customers AS C;
GO

-- Usage example: get companies based in Tehran
SELECT * 
FROM COMPANY_LIST 
WHERE City = N'تهران';



-- View: Order count grouped by year
CREATE VIEW YEARORDERS AS
SELECT
    YEAR(O.OrderDate) AS ORDERYEAR,
    COUNT(O.OrderID) AS NUM
FROM Orders AS O
GROUP BY YEAR(O.OrderDate);
GO

-- Usage example: orders in year 2014
SELECT * 
FROM YEARORDERS 
WHERE ORDERYEAR = 2014;
