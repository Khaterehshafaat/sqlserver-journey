-- View: List of companies with their order count

CREATE VIEW VW_COMPANY_LIST AS
SELECT
    C.CompanyName,
    C.City,
    (SELECT COUNT(O.OrderID) 
     FROM Orders AS O 
     WHERE O.CustomerID = C.CustomerID) AS NUM
FROM Customers AS C;
GO

-- Usage example: get companies based in Tehran
SELECT * 
FROM VW_COMPANY_LIST 
WHERE City = N'تهران';



-- View: Order count grouped by year
CREATE VIEW VW_YEARORDERS AS
SELECT
    YEAR(O.OrderDate) AS ORDERYEAR,
    COUNT(O.OrderID) AS NUM
FROM Orders AS O
GROUP BY YEAR(O.OrderDate);
GO

-- Usage example: orders in year 2014
SELECT * 
FROM VW_YEARORDERS 
WHERE ORDERYEAR = 2014;





-- ================================================
-- View in View example
-- ================================================

-- View 1: Order count per employee
CREATE VIEW VW_EMPLOYEE_ORDER_COUNT AS
SELECT 
    EmployeeID, 
    COUNT(OrderID) AS NUM
FROM Orders
GROUP BY EmployeeID;
GO

-- View 2: Employees with more than 100 orders (built on top of View 1)
CREATE VIEW VW_RANGE_EMPLOYEES_ORDERCOUNT AS
SELECT * 
FROM VW_EMPLOYEE_ORDER_COUNT
WHERE NUM > 100;
GO

-- Usage: filter further on the second view
SELECT * 
FROM VW_RANGE_EMPLOYEES_ORDERCOUNT 
WHERE NUM < 120;
