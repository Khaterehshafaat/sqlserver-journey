/*
SP With Input Parameters
*/

DROP PROCEDURE IF EXISTS GetEmployeeByID;
GO

CREATE PROCEDURE GetEmployeeByID
(
	@ID INT
)
AS
BEGIN
	SELECT 
		EmployeeID, FirstName, LastName
	FROM dbo.Employees
		WHERE EmployeeID = @ID;
END
GO

-- First way to call the SP with an input parameter
EXEC GetEmployeeByID 1;
GO

-- Second way to call the SP with an input parameter
EXEC GetEmployeeByID @ID = 1;
GO

-- Third way to call the SP with an input parameter
GetEmployeeByID 1;
GO
