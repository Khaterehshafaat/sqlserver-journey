-- =====================================================================
-- Question: Last Order per Customer (CRM - Inactive Customer Detection)
-- The CRM team wants to find the most recent order for each customer
-- in order to identify inactive or low-engagement customers.
--
-- Expected output:
--   - Customer
--   - Order Date
--   - Order Number
--   - Recency (days since the last order)
-- =====================================================================


WITH CustOrder AS (
    SELECT
        o.CustomerID,
        o.OrderID,
        o.OrderDate,
        ROW_NUMBER() OVER (
            PARTITION BY o.CustomerID
            ORDER BY OrderDate DESC, o.OrderID DESC
        ) AS RN
    FROM Orders AS o
),


Recency AS (
    SELECT *
    FROM CustOrder
    WHERE RN = 1
)

SELECT
    *,
    DATEDIFF(DAY, r.OrderDate, GETDATE()) AS Recency
FROM Recency AS r
ORDER BY Recency DESC;




