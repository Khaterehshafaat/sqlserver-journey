QUESTION 3
-- =====================================================================
-- Question: Order Amount Change vs. Previous Order (per Employee)
-- The sales manager wants to know, for each order placed by an employee,
-- how much the order amount changed compared to that same employee's
-- previous order.
--
-- Expected output:
--   - Employee
--   - Order
--   - Order Date
--   - Order Amount
--   - Previous Order Amount
--   - Difference from Previous Order
-- =====================================================================

-- Step 1: Calculate the total amount of each order
--         (Quantity * UnitPrice, adjusted for discount)
WITH OrderAmount AS (
    SELECT
        o.EmployeeID,
        o.OrderDate,
        o.OrderID,
        SUM(od.Quantity * od.UnitPrice * (1 - od.Discount)) AS OrderAmount
    FROM Orders AS o
    INNER JOIN [Order Details] AS od
        ON o.OrderID = od.OrderID
    GROUP BY o.EmployeeID, o.OrderDate, o.OrderID
)

SELECT
    o.EmployeeID,
    o.OrderDate,
    o.OrderID,
    o.OrderAmount,
    LAG(o.OrderAmount) OVER (
        PARTITION BY o.EmployeeID
        ORDER BY o.OrderDate, o.OrderID
    ) AS PrevOrderAmount,
    o.OrderAmount - LAG(o.OrderAmount) OVER (
        PARTITION BY o.EmployeeID
        ORDER BY o.OrderDate, o.OrderID
    ) AS DiffFromPrevOrder
FROM OrderAmount AS o
ORDER BY o.EmployeeID, o.OrderDate, o.OrderID;


