-- Combining EXISTS with an extra condition on the target table


UPDATE C
SET CompanyName = 'FERESHTEHCOMPANY'
FROM Customers1 AS C
WHERE EXISTS (
    SELECT 1
    FROM Orders AS O
    WHERE C.CustomerID = O.CustomerID
)
AND C.State = N'یزد';
GO

