    LEAD(Val) OVER (
        PARTITION BY custid
        ORDER BY orderdate, orderid
    ) AS Nxt_Val,
    SUM(Val) OVER (
        PARTITION BY custid
        ORDER BY orderdate, orderid
    ) AS Sum_Val
FROM Sales.OrderValues;
