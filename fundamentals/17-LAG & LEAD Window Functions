WITH CTE AS
(
    SELECT
        custid,
        orderdate,
        orderid,
        val,
        ROW_NUMBER() OVER (
            ORDER BY custid, orderdate, orderid
        ) AS Nxt_Val
    FROM Sales.OrderValues
)
SELECT
    CTE.custid,
    CTE.orderdate,
    CTE.orderid,
    CTE.val,
    C.Val AS Nxt_Val
FROM CTE
LEFT JOIN CTE AS C
    ON CTE.custid = C.custid
    AND CTE.Nxt_Val = C.Nxt_Val - 1;
GO

